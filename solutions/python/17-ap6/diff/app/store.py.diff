+"""Videos and jobs in SQLite under the data directory, so they survive a restart."""
+
+import json
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+from typing import Any
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS videos (
+    id TEXT PRIMARY KEY,
+    filename TEXT NOT NULL,
+    path TEXT NOT NULL,
+    size_bytes INTEGER NOT NULL
+);
+CREATE TABLE IF NOT EXISTS jobs (
+    id TEXT PRIMARY KEY,
+    video_id TEXT NOT NULL REFERENCES videos(id),
+    detector TEXT NOT NULL,
+    status TEXT NOT NULL,
+    error TEXT,
+    segments TEXT,
+    created INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS jobs_by_status ON jobs (status, created);
+"""
+
+
+class Store:
+    def __init__(self, data_dir: Path) -> None:
+        self.path = data_dir / "framewise.db"
+        with closing(self._connect()) as db, db:
+            db.executescript(SCHEMA)
+
+    def _connect(self) -> sqlite3.Connection:
+        db = sqlite3.connect(self.path, timeout=10)
+        db.row_factory = sqlite3.Row
+        return db
+
+    def _one(self, sql: str, *args: Any) -> sqlite3.Row | None:
+        with closing(self._connect()) as db:
+            return db.execute(sql, args).fetchone()
+
+    def _write(self, sql: str, *args: Any) -> None:
+        with closing(self._connect()) as db, db:
+            db.execute(sql, args)
+
+    def add_video(self, video_id: str, filename: str, path: Path, size_bytes: int) -> None:
+        self._write(
+            "INSERT INTO videos (id, filename, path, size_bytes) VALUES (?, ?, ?, ?)",
+            video_id, filename, str(path), size_bytes,
+        )
+
+    def video(self, video_id: str) -> dict[str, Any] | None:
+        row = self._one("SELECT * FROM videos WHERE id = ?", video_id)
+        return dict(row) if row else None
+
+    def add_job(self, job_id: str, video_id: str, detector: str) -> None:
+        self._write(
+            "INSERT INTO jobs (id, video_id, detector, status, created)"
+            " VALUES (?, ?, ?, 'PENDING', strftime('%s', 'now'))",
+            job_id, video_id, detector,
+        )
+
+    def job(self, job_id: str) -> dict[str, Any] | None:
+        row = self._one("SELECT * FROM jobs WHERE id = ?", job_id)
+        if row is None:
+            return None
+        job = dict(row)
+        job["segments"] = json.loads(job["segments"]) if job["segments"] else None
+        del job["created"]
+        return job
+
+    def mark_running(self, job_id: str) -> None:
+        self._write("UPDATE jobs SET status = 'RUNNING' WHERE id = ?", job_id)
+
+    def finish(self, job_id: str, segments: list[dict[str, float]]) -> None:
+        self._write(
+            "UPDATE jobs SET status = 'DONE', segments = ? WHERE id = ?",
+            json.dumps(segments), job_id,
+        )
+
+    def fail(self, job_id: str, error: str) -> None:
+        self._write("UPDATE jobs SET status = 'FAILED', error = ? WHERE id = ?", error, job_id)
+
+    def unfinished(self) -> list[str]:
+        """Jobs a previous run left PENDING or RUNNING, oldest first."""
+        with closing(self._connect()) as db:
+            rows = db.execute(
+                "SELECT id FROM jobs WHERE status IN ('PENDING', 'RUNNING') ORDER BY created, rowid"
+            ).fetchall()
+        return [row["id"] for row in rows]
