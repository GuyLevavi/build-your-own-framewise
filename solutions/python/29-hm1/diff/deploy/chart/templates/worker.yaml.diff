--- a/deploy/chart/templates/worker.yaml
+++ b/deploy/chart/templates/worker.yaml
@@ -0,0 +1,26 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: {{ .Release.Name }}-worker
+  labels: {{- include "framewise.labels" . | nindent 4 }}
+spec:
+  replicas: {{ .Values.worker.replicas }}
+  selector:
+    matchLabels: {app.kubernetes.io/component: worker, app.kubernetes.io/instance: {{ .Release.Name }}}
+  template:
+    metadata:
+      labels:
+        {{- include "framewise.labels" . | nindent 8 }}
+        app.kubernetes.io/component: worker
+      annotations:
+        checksum/profiles: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
+    spec:
+      terminationGracePeriodSeconds: 60   # time to give the job back after SIGTERM
+      containers:
+        - name: worker
+          image: {{ include "framewise.image" . }}
+          args: [work]
+          env: {{- include "framewise.env" . | nindent 12 }}
+          volumeMounts: {{- include "framewise.mounts" . | nindent 12 }}
+          resources: {{- toYaml .Values.worker.resources | nindent 12 }}
+      volumes: {{- include "framewise.volumes" . | nindent 8 }}
