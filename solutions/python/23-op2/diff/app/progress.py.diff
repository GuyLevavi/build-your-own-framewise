--- a/app/progress.py
+++ b/app/progress.py
@@ -0,0 +1,47 @@
+"""A job's progress as server-sent events, fed by Postgres LISTEN/NOTIFY.
+
+Workers NOTIFY on PROGRESS_CHANNEL as they commit batches; each open stream
+holds one listening connection and forwards its job's notifications. Every few
+seconds without one it reads the job again, which catches what NOTIFY can't
+tell it: a worker that died, or a job failed by another worker's claim.
+"""
+
+import json
+from collections.abc import AsyncIterator
+
+import psycopg
+from starlette.concurrency import run_in_threadpool
+
+from app.db import libpq_url
+from app.store import PROGRESS_CHANNEL, Status, Store
+
+FINISHED = {Status.DONE, Status.FAILED}
+
+
+def _event(status: Status, progress: float) -> str:
+    return f"data: {json.dumps({'status': status.value, 'progress': progress})}\n\n"
+
+
+async def progress_events(store: Store, job_id: str, recheck_s: float = 5.0) -> AsyncIterator[str]:
+    async with await psycopg.AsyncConnection.connect(libpq_url(), autocommit=True) as conn:
+        # LISTEN before reading the job, so nothing between the two is missed.
+        await conn.execute(f"LISTEN {PROGRESS_CHANNEL}")
+        job = await run_in_threadpool(store.job, job_id)
+        if job is None:
+            return
+        state = (job.status, job.progress)
+        yield _event(*state)
+        while state[0] not in FINISHED:
+            async for notify in conn.notifies(timeout=recheck_s):
+                payload = json.loads(notify.payload)
+                if payload["job_id"] != job_id:
+                    continue
+                state = (Status(payload["status"]), payload["progress"])
+                yield _event(*state)
+                if state[0] in FINISHED:
+                    break
+            else:
+                job = await run_in_threadpool(store.job, job_id)
+                if job is not None and (job.status, job.progress) != state:
+                    state = (job.status, job.progress)
+                    yield _event(*state)
