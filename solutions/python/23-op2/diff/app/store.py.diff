+# Workers NOTIFY here as jobs advance; payloads are {"job_id", "status", "progress"}.
+PROGRESS_CHANNEL = "framewise_progress"
+
+
+def _notify(conn: sa.Connection, job_id: str, status: Status, progress: float) -> None:
+    """Delivered when the transaction commits, so listeners never see uncommitted progress."""
+    payload = json.dumps({"job_id": job_id, "status": status.value, "progress": progress})
+    conn.execute(sa.select(sa.func.pg_notify(PROGRESS_CHANNEL, payload)))
+
