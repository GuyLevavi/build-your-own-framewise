# One image for the API, the worker and migrations: the command picks which.
#   podman build --build-arg BASE_IMAGE=<the Python base image in your registry> -t framewise .
#   podman run --user 1000620000:0 framewise serve --port 8000 --data-dir /data
ARG BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# ---- build: uv and the package downloads stay here
FROM ${BASE_IMAGE} AS build
WORKDIR /src
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never
# Dependencies first: this layer is reused until uv.lock changes.
COPY pyproject.toml uv.lock ./
COPY vendor vendor
RUN uv sync --locked --no-dev --no-install-project
COPY app app

# ---- runtime: the virtualenv and the code, nothing else
FROM ${BASE_IMAGE}
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /src/app app
# OpenShift runs the container as a random UID in group 0 and ignores USER.
# Whatever the app writes must belong to group 0 and be group-writable.
RUN mkdir -p /data && chgrp -R 0 /app /data && chmod -R g=u /app /data
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 1001
# The program itself is PID 1 (exec form, no shell), so SIGTERM reaches it.
ENTRYPOINT ["python", "-m", "app.main"]
