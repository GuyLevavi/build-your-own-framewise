--- a/app/metrics.py
+++ b/app/metrics.py
@@ -0,0 +1,64 @@
+"""Prometheus metrics for the API.
+
+Request timings are measured in this process. Job counts are not: workers are
+other processes, so a counter here would only see this one. framewise_jobs is
+read from the database when Prometheus scrapes, which is true for every replica.
+"""
+
+import time
+from collections.abc import Awaitable, Callable, Iterator
+
+from fastapi import FastAPI, Request, Response
+from prometheus_client import CONTENT_TYPE_LATEST, CollectorRegistry, Histogram, generate_latest
+from prometheus_client.core import CounterMetricFamily, GaugeMetricFamily
+from prometheus_client.registry import Collector
+
+from app.store import Status, Store
+
+
+class JobsCollector(Collector):
+    def __init__(self, store: Store) -> None:
+        self.store = store
+
+    def collect(self) -> Iterator[GaugeMetricFamily | CounterMetricFamily]:
+        gauge = GaugeMetricFamily("framewise_jobs", "Jobs by status.", labels=["status"])
+        counts = self.store.count_jobs()
+        for status in Status:
+            gauge.add_metric([status.value], counts.get(status, 0))
+        yield gauge
+        yield CounterMetricFamily(
+            "framewise_frames_analyzed",
+            "Frames analyzed by finished jobs: its rate is the service's frames per second.",
+            value=self.store.frames_analyzed(),
+        )
+
+
+def instrument(app: FastAPI, store: Store) -> None:
+    """Time every request by route template, and serve GET /metrics."""
+    registry = CollectorRegistry()
+    registry.register(JobsCollector(store))
+    seconds = Histogram(
+        "framewise_http_request_duration_seconds",
+        "HTTP request duration by route template.",
+        ["method", "route", "status"],
+        registry=registry,
+    )
+
+    @app.middleware("http")
+    async def time_requests(
+        request: Request, call_next: Callable[[Request], Awaitable[Response]]
+    ) -> Response:
+        start = time.perf_counter()
+        response = await call_next(request)
+        # The template (/jobs/{job_id}), never the path: one series per route,
+        # not one per job.
+        route = request.scope.get("route")
+        template = getattr(route, "path", "unmatched")
+        seconds.labels(request.method, template, str(response.status_code)).observe(
+            time.perf_counter() - start
+        )
+        return response
+
+    @app.get("/metrics", include_in_schema=False)
+    def metrics() -> Response:
+        return Response(generate_latest(registry), media_type=CONTENT_TYPE_LATEST)
