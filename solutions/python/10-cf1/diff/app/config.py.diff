+"""Detector settings: built-in defaults, or named detectors from a YAML file."""
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import yaml
+
+
+@dataclass(frozen=True)
+class Detector:
+    threshold: int = 25
+    min_area: int = 20
+
+
+@dataclass(frozen=True)
+class Config:
+    detectors: dict[str, Detector]
+    max_gap_s: float = 0.5
+
+    def detector(self, name: str) -> Detector:
+        return self.detectors[name]
+
+
+DEFAULT = Config(detectors={"default": Detector()})
+
+
+def load(path: Path | None) -> Config:
+    if path is None:
+        return DEFAULT
+    raw = yaml.safe_load(path.read_text())
+    return Config(
+        detectors={str(name): Detector(**settings) for name, settings in raw["detectors"].items()},
+        max_gap_s=float(raw.get("max_gap_s", 0.5)),
+    )
