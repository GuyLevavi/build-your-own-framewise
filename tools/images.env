# The container images the course uses, by default. tools/make_release.sh saves each into the
# airgap tarballs (images/, loaded with images/load.sh); .gitlab-ci.yml and the tester default to
# the same names, so nothing needs setting online or offline. Override any of them in the
# environment (or as GitLab CI/CD variables) to use a mirror.
CI_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim            # this repo's CI: bash, git, python3
GO_IMAGE=docker.io/library/golang:1.24-bookworm                   # this repo's CI: the tester's jobs
FRAMEWISE_CI_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim  # ci1: the learner's pipeline jobs
FRAMEWISE_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim # im1: the Containerfile's BASE_IMAGE
FRAMEWISE_POSTGRES_IMAGE=docker.io/library/postgres:18            # ap1 on, im2, ci1's service
