#!/usr/bin/env bash
# Run codecrafters-io/course-sdk locally, patched to work offline with podman:
#   - uses the tester built in ../framewise-tester/dist instead of a GitHub release
#   - adds the Dockerfile's generated sections locally instead of calling CodeCrafters' backend
#   - accepts podman's build output
# The checkout lives in tools/.course-sdk (git-ignored), pinned to tools/course-sdk.rev.
#
#   tools/course-sdk compile python
#   tools/course-sdk test python
set -euo pipefail

tools="$(cd "$(dirname "$0")" && pwd)"
sdk="$tools/.course-sdk"
rev="$(cat "$tools/course-sdk.rev")"

if [[ ! -d "$sdk/.git" ]]; then
  git clone -q https://github.com/codecrafters-io/course-sdk "$sdk"
  git -C "$sdk" checkout -q "$rev"
  git -C "$sdk" apply "$tools/course-sdk-offline.patch"
fi

run_bun() {
  if command -v bun >/dev/null; then bun "$@"; else nix shell nixpkgs#bun -c bun "$@"; fi
}
[[ -d "$sdk/node_modules" ]] || (cd "$sdk" && run_bun install --frozen-lockfile >/dev/null)

tester_dir="${COURSE_SDK_TESTER_DIR:-$tools/../../framewise-tester/dist}"
if [[ ! -x "$tester_dir/tester" ]]; then
  if command -v go >/dev/null; then make -C "$tester_dir/.." build; else nix shell nixpkgs#go nixpkgs#gnumake -c make -C "$tester_dir/.." build; fi
fi

export COURSE_SDK_OFFLINE=1
export COURSE_SDK_TESTER_DIR="$(cd "$tester_dir" && pwd)"
export CONTAINERS_REGISTRIES_CONF="${CONTAINERS_REGISTRIES_CONF:-$tools/registries.conf}"
# `bun build --compile` hits a bundler bug in current Bun; running the sources directly works.
run_bun "$sdk/cli.ts" "$@"
